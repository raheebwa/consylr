#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Refuses a commit that would break a rule this project states.
# Installed by: git config core.hooksPath .githooks
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
branch="$(git symbolic-ref --short -q HEAD || true)"
rc=0

if [ "$branch" = "main" ]; then
  printf 'pre-commit: main takes changes through a pull request.\n  Start a branch: git switch -c <type>/<short-description>\n' >&2
  exit 1
fi

types='feat|fix|docs|style|refactor|perf|test|chore'
if [ -n "$branch" ] && ! printf '%s' "$branch" | grep -qE "^($types)/[a-z0-9._-]+$"; then
  printf 'pre-commit: branch "%s" is not <type>/<short-description>.\n  Types: %s\n' "$branch" "${types//|/ }" >&2
  exit 1
fi

# Judge the staged content, not the working tree: a partially staged file is
# committed as staged, and that is the version the rules have to hold for.
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
staged=()
while IFS= read -r -d '' f; do
  staged+=("$f")
  mkdir -p "$tmp/$(dirname "$f")"
  git show ":$f" > "$tmp/$f" 2>/dev/null || true
done < <(git diff --cached --name-only --diff-filter=ACM -z)

[ ${#staged[@]} -eq 0 ] && exit 0

if ! ( cd "$tmp" && bash "$root/.githooks/checks.sh" all "${staged[@]}" ); then
  printf 'pre-commit: staged content fails a project rule (above).\n' >&2
  rc=1
fi

# The hooks carry their own tests; a hook nobody tested enforces nothing.
if [ -f "$root/tests/hooks/run.sh" ]; then
  bash "$root/tests/hooks/run.sh" >/dev/null 2>&1 \
    || { printf 'pre-commit: tests/hooks/run.sh fails.\n' >&2; rc=1; }
fi

# Once the package is installable, its own gates apply to every commit. A hook
# runs in whatever shell git invokes, which is not necessarily one where the
# project environment is activated, so look in the documented location too.
[ -d "$root/.venv/bin" ] && PATH="$root/.venv/bin:$PATH"

# ruff is a mise-provided binary rather than a Python dependency, and a git
# hook's shell has not activated the toolchain the project declares. Resolve it
# by path rather than by wrapping every gate in `mise exec` — an unquoted
# command prefix does not word-split under every shell, which turns the wrapper
# itself into a command that does not exist.
if command -v mise >/dev/null 2>&1; then
  mise_ruff="$(mise which ruff 2>/dev/null || true)"
  [ -n "$mise_ruff" ] && PATH="$(dirname "$mise_ruff"):$PATH"
fi

if [ -f "$root/pyproject.toml" ]; then
  # Probe exactly what the gates invoke. A guard that checks a different thing
  # than it protects will pass and then let bare "command not found" lines
  # through with no diagnostic.
  missing=""
  command -v python >/dev/null 2>&1 || missing=" python"
  command -v ruff   >/dev/null 2>&1 || missing="$missing ruff"
  for t in mypy pytest; do
    python -c "import $t" >/dev/null 2>&1 || missing="$missing $t"
  done
  if [ -n "$missing" ]; then
    printf 'pre-commit: not available:%s\n  Run: mise install && mise exec -- uv pip install -e ".[dev]"\n' "$missing" >&2
    rc=1
  else
    # Exactly the commands CONTRIBUTING.md documents, run the way it documents
    # them. `pytest <path>` and `python -m pytest` differ in what lands on
    # sys.path, so a hook that invokes the undocumented form can fail where the
    # documented one passes — which teaches people to distrust the hook.
    #
    # These four judge the WORKING TREE, unlike the staged-content checks above.
    # They need an importable, installed package, which a snapshot of staged
    # blobs is not. Saying so is better than implying a guarantee that is not
    # given: the committed tree is CI's job, and CI is the authority on it.
    ( cd "$root" && ruff check . )          || rc=1
    ( cd "$root" && ruff format --check . ) || rc=1
    ( cd "$root" && python -m mypy )        || rc=1
    ( cd "$root" && python -m pytest )      || rc=1
  fi
fi

ext="$(git rev-parse --git-common-dir)/hooks/pre-commit.local"
[ -x "$ext" ] && { "$ext" || rc=1; }

exit $rc
