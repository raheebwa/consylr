#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Rejects a commit message that does not match this project's conventions.
# Installed by: git config core.hooksPath .githooks
set -uo pipefail

msg_file="$1"
body="$(grep -v '^#' "$msg_file")"
subject="$(printf '%s\n' "$body" | sed -n '1p')"

die() { printf 'commit-msg: %s\n\n  %s\n\n' "$1" "$subject" >&2; exit 1; }

# A merge or revert subject is written by git itself and is exempt from the format.
case "$subject" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|chore'

printf '%s' "$subject" | grep -qE "^($types)(\([a-z0-9-]+\))?: .+" \
  || die "subject must be <type>(<scope>): <subject> with a lowercase type from: ${types//|/ }"

[ "${#subject}" -le 50 ] \
  || die "subject is ${#subject} characters; the limit is 50"

grep -qE '^Signed-off-by: .+ <.+@.+>' "$msg_file" \
  || die "missing a sign-off; commit with -s to certify under the DCO"

# Signed-off-by is the only trailer this project uses, so provenance in the
# history means exactly one thing.
#
# Stated as "only this one is allowed" rather than as a list of forbidden
# trailers. A denylist has to be maintained in step with whatever it forbids,
# and writing the banned names into a committed file publishes the very thing
# it is meant to keep out. Anything trailer-shaped that is not a sign-off is a
# defect here, whoever or whatever added it.
#
# Only the LAST paragraph is examined, which is where git itself looks for
# trailers. A body line that merely begins with a word and a colon is prose:
# "measured: 130 tokens" is a sentence, not a trailer, and rejecting it would
# make the hook something people route around with --no-verify.
#
# The subject is dropped first, so a subject like "docs: add a thing" is not
# mistaken for a trailer by the same pattern.
rest="$(printf '%s\n' "$body" | tail -n +2)"
last_block="$(printf '%s\n' "$rest" | awk -v RS='' 'END{print}')"
stray="$(printf '%s\n' "$last_block" | grep -E '^[A-Za-z][A-Za-z-]*: ' \
         | grep -vE '^Signed-off-by: ' || true)"
[ -z "$stray" ] || die "only Signed-off-by is permitted as a trailer; found: ${stray}"

exit 0
